# The app and model servers default to this machine.
API_HOST=127.0.0.1
API_PORT=8765
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173

# See the provider table in README.md. Restart after changing the provider.
LLM_PROVIDER=ollama
# LLM_BASE_URL=http://127.0.0.1:1234/v1
# LLM_CHAT_MODEL=your-model-id
# LLM_UTILITY_MODEL=your-model-id
# LLM_API_KEY=your-provider-key
LLM_ALLOW_REMOTE=false

# ollama, same, compatible or disabled
LLM_EMBED_PROVIDER=ollama
# LLM_EMBED_MODEL=nomic-embed-text
# LLM_EMBED_BASE_URL=http://127.0.0.1:1234/v1
# LLM_EMBED_API_KEY=your-embedding-key
LLM_ALLOW_REMOTE_EMBEDDINGS=false

# Defaults for the original Ollama profile
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_UTILITY_MODEL=llama3.2:1b
OLLAMA_EMBED_MODEL=nomic-embed-text
